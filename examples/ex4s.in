% Short transient power-law test (regression case): the dislocation creep and the
% heat-equation settings of ex4 on a small grid, with coupled temperature (frictional heat as a
% boundary flux: wVals of 0) and the implicit-explicit integrator; about 30 s (debug build).
Ny = 61 # points in y-direction
Nz = 81 # points in z-direction
Ly = 100 # (km) horizontal domain size
Lz = 50 # (km) vertical domain size
bCoordTrans = 5 # grid stretching perpendicular to the fault
bulkDeformationType = powerLaw
momentumBalanceType = quasidynamic
systemEvolutionType = transient
guessSteadyStateICs = 1 # estimate steady-state initial conditions (viscosity and fault stress)
stateLaw = agingLaw
DcVals = [8e-3 8e-3] # (m) small, so the first event comes within the run
DcDepths = [0 60] # (km)
aVals = [0.0135 0.0300 0.0700 0.2652]
aDepths = [0 11.0000 19.3333 60]
bVals = [0.0230 0.0379 0.0350 0.0375 0.0497]
bDepths = [0 10 11 19.3333 60]
sNVals = [50 50] # (MPa) effective normal stress
sNDepths = [0 60]
sN_floor = 5.5 # MPa
linSolverSS = MUMPSCHOLESKY
linSolverTrans = MUMPSCHOLESKY
muVals = [30 30] # (GPa) shear modulus
muDepths = [0 60] # (km)
rhoVals = [3 3] # (g/cm^3)
rhoDepths = [0 60] # (km)
disl_AVals = [1585 1585] # (MPa^-n s^-1) dislocation creep of ex4
disl_ADepths = [0 100]
disl_QRVals = [4.157e4 4.157e4] # Q/R (K)
disl_QRDepths = [0 100]
disl_nVals = [3 3]
disl_nDepths = [0 100]
maxEffVisc = 1e18 # GPa s
kVals = [1.89e-9 1.89e-9] # conductivity (km^2 kPa/K/s)
kDepths = [0 60]
cVals = [900 900] # (J/K/g) specific heat
cDepths = [0 60]
TVals = [283.15 1373.15] # (K) linear geotherm: viscous below about 30 km
TDepths = [0 50]
heatEquationType = transient
withViscShearHeating = yes
withFrictionalHeating = yes
withRadioHeatGeneration = yes
initTime = 0 # (s)
initDeltaT = 1e-3 # (s)
maxTime = 1e12 # (s)
maxDeltaT = 1e10 # (s)
maxStepCount = 200 # a short run: the first event and its start
timeStepTol = 1e-7
timeIntInds = [psi slip] # variables to use to compute time step
stride1D = 10
stride2D = 50
saveChkpts = 1
strideChkpt = 100
restartFromChkpt = 1 # continue from data in outputDir if a run stopped
restartFromChkptSS = 0
thermalCoupling = coupled
evolveTemperature = 1
timeIntegrator = RK43_WBE
wVals = [0 0] # (m) frictional heat as a boundary flux
wDepths = [0 50]
outputDir = data/ex4s_
