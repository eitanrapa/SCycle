% Short transient power-law test (regression case) with grain-size evolution: ex4s with the
% wattmeter grain-size law (Austin & Evans 2007) coupled to diffusion creep, temperature held at
% the geotherm, and the explicit integrator. The grain-size and diffusion-creep constants are
% illustrative, not calibrated to a mineral: the grain size grows about thirtyfold at depth.
Ny = 61 # points in y-direction
Nz = 81 # points in z-direction
Ly = 100 # (km) horizontal domain size
Lz = 50 # (km) vertical domain size
bCoordTrans = 5 # grid stretching perpendicular to the fault
bulkDeformationType = powerLaw
momentumBalanceType = quasidynamic
systemEvolutionType = transient
guessSteadyStateICs = 1 # estimate steady-state initial conditions (viscosity and fault stress)
stateLaw = agingLaw
DcVals = [8e-3 8e-3] # (m) small, so the first event comes within the run
DcDepths = [0 60] # (km)
aVals = [0.0135 0.0300 0.0700 0.2652]
aDepths = [0 11.0000 19.3333 60]
bVals = [0.0230 0.0379 0.0350 0.0375 0.0497]
bDepths = [0 10 11 19.3333 60]
sNVals = [50 50] # (MPa) effective normal stress
sNDepths = [0 60]
sN_floor = 5.5 # MPa
linSolverSS = MUMPSCHOLESKY
linSolverTrans = MUMPSCHOLESKY
muVals = [30 30] # (GPa) shear modulus
muDepths = [0 60] # (km)
rhoVals = [3 3] # (g/cm^3)
rhoDepths = [0 60] # (km)
disl_AVals = [1585 1585] # (MPa^-n s^-1) dislocation creep of ex4
disl_ADepths = [0 100]
disl_QRVals = [4.157e4 4.157e4] # Q/R (K)
disl_QRDepths = [0 100]
disl_nVals = [3 3]
disl_nDepths = [0 100]
maxEffVisc = 1e18 # GPa s
kVals = [1.89e-9 1.89e-9] # conductivity (km^2 kPa/K/s)
kDepths = [0 60]
cVals = [900 900] # (J/K/g) specific heat
cDepths = [0 60]
TVals = [283.15 1373.15] # (K) linear geotherm: viscous below about 30 km
TDepths = [0 50]
heatEquationType = transient
withViscShearHeating = yes
withFrictionalHeating = yes
withRadioHeatGeneration = yes
initTime = 0 # (s)
initDeltaT = 1e-3 # (s)
maxTime = 1e12 # (s)
maxDeltaT = 1e10 # (s)
maxStepCount = 200 # a short run: the first event and its start
timeStepTol = 1e-7
timeIntInds = [psi slip] # variables to use to compute time step
stride1D = 10
stride2D = 50
saveChkpts = 1
strideChkpt = 100
restartFromChkpt = 1 # continue from data in outputDir if a run stopped
restartFromChkptSS = 0
thermalCoupling = no
evolveTemperature = 0
timeIntegrator = RK43
wDiffCreep = yes
diff_AVals = [1.5e6 1.5e6] # illustrative (MPa^-n s^-1, times grain size^m)
diff_ADepths = [0 100]
diff_QRVals = [3e4 3e4] # Q/R (K)
diff_QRDepths = [0 100]
diff_nVals = [1 1]
diff_nDepths = [0 100]
diff_mVals = [3 3] # grain-size exponent
diff_mDepths = [0 100]
evolveGrainSize = 1
grainSizeEvCoupling = coupled
grainSizeEv_grainSizeEvType = transient
grainSizeEv_grainSizeVals = [100 100] # initial grain size (in the length unit the constants imply)
grainSizeEv_grainSizeDepths = [0 100]
grainSizeEv_AVals = [6e7 6e7] # static growth prefactor, illustrative
grainSizeEv_ADepths = [0 100]
grainSizeEv_QRVals = [2e4 2e4] # Q/R (K)
grainSizeEv_QRDepths = [0 100]
grainSizeEv_pVals = [3 3] # growth exponent
grainSizeEv_pDepths = [0 100]
grainSizeEv_gammaVals = [1 1] # specific surface energy
grainSizeEv_gammaDepths = [0 100]
grainSizeEv_c = 3.14159 # geometric constant
grainSizeEv_fVals = [0.015 0.015] # fraction of dislocation work that reduces grain size
grainSizeEv_fDepths = [0 100]
outputDir = data/ex4g_
